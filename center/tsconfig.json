{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "node",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": false,
    "noImplicitAny": false,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": false,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "paths": {
      "@app-src/*": ["./src/*"],
      "@app-back-end/*": ["./back-end/*"],
      "@app-front-end/*": ["./front-end/*"],
      "@dooboostore/algorithm": ["../packages/@dooboostore/algorithm/src"],
      "@dooboostore/algorithm/*": ["../packages/@dooboostore/algorithm/src/*"],
      "@dooboostore/core": ["../packages/@dooboostore/core/src"],
      "@dooboostore/core/*": ["../packages/@dooboostore/core/src/*"],
      "@dooboostore/core-node": ["../packages/@dooboostore/core-node/src"],
      "@dooboostore/core-node/*": ["../packages/@dooboostore/core-node/src/*"],
      "@dooboostore/core-web": ["../packages/@dooboostore/core-web/src"],
      "@dooboostore/core-web/*": ["../packages/@dooboostore/core-web/src/*"],
      "@dooboostore/dom-parser": ["../packages/@dooboostore/dom-parser/src"],
      "@dooboostore/dom-parser/*": ["../packages/@dooboostore/dom-parser/src/*"],
      "@dooboostore/dom-render": ["../packages/@dooboostore/dom-render/src"],
      "@dooboostore/dom-render/*": ["../packages/@dooboostore/dom-render/src/*"],
      "@dooboostore/lib-node": ["../packages/@dooboostore/lib-node/src"],
      "@dooboostore/lib-node/*": ["../packages/@dooboostore/lib-node/src/*"],
      "@dooboostore/lib-web": ["../packages/@dooboostore/lib-web/src"],
      "@dooboostore/lib-web/*": ["../packages/@dooboostore/lib-web/src/*"],
      "@dooboostore/simple-boot": ["../packages/@dooboostore/simple-boot/src"],
      "@dooboostore/simple-boot/*": ["../packages/@dooboostore/simple-boot/src/*"],
      "@dooboostore/simple-boot-front": ["../packages/@dooboostore/simple-boot-front/src"],
      "@dooboostore/simple-boot-front/*": ["../packages/@dooboostore/simple-boot-front/src/*"],
      "@dooboostore/simple-boot-http-server": ["../packages/@dooboostore/simple-boot-http-server/src"],
      "@dooboostore/simple-boot-http-server/*": ["../packages/@dooboostore/simple-boot-http-server/src/*"],
      "@dooboostore/simple-boot-http-server-ssr": ["../packages/@dooboostore/simple-boot-http-server-ssr/src"],
      "@dooboostore/simple-boot-http-server-ssr/*": ["../packages/@dooboostore/simple-boot-http-server-ssr/src/*"],
      "@dooboostore/simple-web-component": ["../packages/@dooboostore/simple-web-component/src"],
      "@dooboostore/simple-web-component/*": ["../packages/@dooboostore/simple-web-component/src/*"],
      "@dooboostore/simple-web-component-library": ["../packages/@dooboostore/simple-web-component-library/src"],
      "@dooboostore/simple-web-component-library/*": ["../packages/@dooboostore/simple-web-component-library/src/*"]
    }
  },
  "include": ["."],
  "exclude": ["node_modules", "dist-*", "packages"]
}
