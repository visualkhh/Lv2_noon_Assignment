{
  "name": "center-app",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "front-end:build": "webpack --config front-end/webpack.config.cjs",
    "front-end:dev": "webpack serve --config front-end/webpack.config.cjs --mode development",
    "back-end:build": "webpack --config back-end/webpack.config.cjs",
    "back-end:start": "node dist-back-end/index.cjs",
    "back-end:dev": "npm run back-end:build && (npm run back-end:build:watch & npm run back-end:start:watch)",
    "back-end:build:watch": "webpack --config back-end/webpack.config.cjs --watch",
    "back-end:start:watch": "node --watch dist-back-end/index.cjs",
    "build": "npm run front-end:build && npm run back-end:build",
    "start": "node dist-back-end/index.cjs"
  },
  "dependencies": {
    "fast-json-patch": "^3.1.0",
    "jsdom": "^26.0.0",
    "linkedom": "0.18.12",
    "mime-types": "^2.1.34",
    "node-gzip": "^1.1.2",
    "playwright": "1.63.0",
    "reflect-metadata": "^0.2.2",
    "three": "^0.180.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/three": "^0.180.0",
    "html-webpack-plugin": "^5.6.3",
    "raw-loader": "^4.0.2",
    "ts-loader": "^9.5.1",
    "tslib": "^2.8.1",
    "typescript": "^5.9.2",
    "webpack": "^5.93.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.2.0"
  }
}
